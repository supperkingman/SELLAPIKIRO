# .env cho ai.mmodiary.com — site DOC LAP voi api.mmodiary.com.
#
# Copy thanh .env roi dien. Sinh moi mat khau bang:
#   openssl rand -hex 32

# --- Ten & cong ---
# Cong 8090-8092 de khong dung voi api.mmodiary.com (dang dung 8080-8083).
SITE_NAME=aikiro
KIRO_PORT=8090
KEYADMIN_PORT=8092
SITE_LABEL=ai.mmodiary.com

# --- Mat khau ---
# KHONG dung lai mat khau cua api.mmodiary.com. Hai site dung chung mat khau thi
# ro ri mot ben la mat ca hai. Rieng ADMIN_PASSWORD cua site cu da bi dan vao chat
# nen coi nhu da lo — cang khong nen dung lai.
ADMIN_PASSWORD=
KEYADMIN_TOKEN=

# --- Bot Telegram ---
# 1. Token bot: chat @BotFather -> /newbot -> copy token.
TELEGRAM_BOT_TOKEN=
# 2. Chat ID duoc phep. Nhieu nguoi thi phan cach bang dau phay.
#    Lay chat ID: chat @userinfobot, no tra ve "Id: 123456789".
#
#    Day la thu DUY NHAT ngan nguoi la tao key: username bot ai cung tim duoc va
#    ai cung chat duoc voi no. De trong thi bot TU CHOI khoi dong, co tinh nhu vay.
TELEGRAM_ADMIN_IDS=
